{
  // ─────────────────────────────────────────────────────────────────────────────
  // SNS Furniture catalog site  +  Authorize.Net Accept Hosted checkout API
  //
  //   Top-level config  = the production Worker "sns-furniture" (snsfurniture.com).
  //                       NOT deployed — production activation is gated on explicit
  //                       user approval and a wired-up TaxJar production config.
  //   [env.staging]      = a SEPARATE Worker "sns-furniture-staging"
  //                       (sns-furniture-staging.chongsk1225.workers.dev) for
  //                       end-to-end sandbox testing. Shares nothing with prod.
  //
  // NO "routes" / "route": the snsfurniture.com Workers Custom Domain, DNS and
  // email are untouched. Static assets are served first; the Worker script only
  // runs for unmatched paths (i.e. /api/checkout/*).
  //
  // Delivery only, California delivery addresses only. TaxJar validates the
  // delivery address and calculates destination-based CA tax; it is the sole
  // authority for "is this a valid California address". The "manual" tax provider
  // is a LOCAL automated-test fixture only — it requires ALLOW_MANUAL_TAX="true",
  // which is set only in the local .dev.vars and never in staging/production.
  // ─────────────────────────────────────────────────────────────────────────────
  "name": "sns-furniture",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    // Non-secret config only. Secrets (AUTHORIZE_NET_*, TAXJAR_API_KEY) are set
    // with `wrangler secret put`.
    "ALLOWED_ORIGINS": "https://snsfurniture.com",
    "TAX_PROVIDER": "",
    "TAXJAR_API_BASE": "https://api.taxjar.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sns-furniture-orders",
      // Placeholder. Real id is filled in only when the production D1 is created,
      // which is out of scope. Local `wrangler dev` uses a local SQLite file and
      // ignores this value.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "env": {
    "staging": {
      "name": "sns-furniture-staging",
      "main": "src/worker.js",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./public",
        "binding": "ASSETS"
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://sns-furniture-staging.chongsk1225.workers.dev",
        "TAX_PROVIDER": "taxjar",
        "TAXJAR_API_BASE": "https://api.sandbox.taxjar.com"
        // No TAX_MANUAL_RATE / ALLOW_MANUAL_TAX here — the manual fixture cannot run in staging.
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sns-furniture-orders-staging",
          "database_id": "a918004f-b3b0-49e2-94f3-67349986bb6d"
        }
      ]
    }
  }
}
