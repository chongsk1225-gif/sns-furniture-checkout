# Copy to `.dev.vars` (git-ignored) for local `wrangler dev` only.
# SANDBOX credentials exclusively. Never put production keys here.
# Names mirror the Cloudflare encrypted secrets used in staging/production.

# --- Authorize.Net (sandbox / test-mode values only) ---
AUTHORIZE_NET_API_LOGIN_ID=""
AUTHORIZE_NET_TRANSACTION_KEY=""
AUTHORIZE_NET_SIGNATURE_KEY=""
AUTHORIZE_NET_ENVIRONMENT="sandbox"

# --- Tax ---
# Real CDTFA city/county district rate table (src/lib/ca-district-tax-rates.json).
# No external account, no API key, no network call — nothing else to set here.
TAX_PROVIDER="ca-district-table"

# --- App ---
ALLOWED_ORIGINS="http://localhost:8787,http://127.0.0.1:8787"
CSRF_SIGNING_SECRET="local-dev-csrf-secret-change-me"
